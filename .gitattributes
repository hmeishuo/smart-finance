# 統一換行字元：文字檔在 repo 與工作目錄一律使用 LF，
# 避免 Windows（CRLF）與雲端容器／部署腳本（LF）混用造成問題。
* text=auto eol=lf

# Windows 專用腳本維持 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二進位檔，不做換行轉換
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.xlsx binary
*.xls  binary
*.zip  binary
*.woff binary
*.woff2 binary
