# =====================================================
# Smart Finance - .gitignore
# 原則：任何機密（金鑰、密碼、Token、連線字串）都不得提交。
# =====================================================

# ---------- 環境變數與機密 ----------
# 所有 .env 檔案一律忽略（含 .env.local、.env.production 等），
# 只有範例檔 .env.example 可以提交，且範例檔不得填入真實值。
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*.json
service-account*.json

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# ---------- Node / 前端 ----------
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vercel/

# ---------- Supabase 本機暫存 ----------
supabase/.temp/
supabase/.branches/

# ---------- 使用者上傳與匯出（可能含真實財務資料） ----------
uploads/
exports/
*.sqlite
*.sqlite3
*.db

# ---------- 記錄檔 ----------
*.log
logs/

# ---------- IDE ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# ---------- 作業系統 ----------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
